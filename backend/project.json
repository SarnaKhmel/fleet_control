{
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "backend/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx watch src/server.ts", "cwd": "backend" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "backend" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "node dist/server.js", "cwd": "backend" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "backend" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "backend" }
    }
  }
}
