{
  "name": "fleet-control",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet Mission Control — learning project (drone fleet dashboard)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=2 --projects=frontend,backend --output-style=stream-without-prefixes",
    "dev:frontend": "nx run frontend:dev",
    "dev:backend": "nx run backend:dev",
    "start": "nx run backend:start",
    "test": "nx run-many -t test",
    "test:frontend": "nx run frontend:test",
    "test:backend": "nx run backend:test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "ws": "^8.22.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "nx": "latest",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
